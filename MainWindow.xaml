<Window x:Class="Info_Extreme_System.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Info_Extreme_System.ViewModels"
        xmlns:controls="clr-namespace:Info_Extreme_System.Controls"
        mc:Ignorable="d"
        Title="ІЕІТ — Система розпізнавання образів"
        Height="860" Width="1340"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#F8FAFC">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- VECTOR ICON GEOMETRIES (Minimalist, Monochrome, High-Clarity) -->
        <Geometry x:Key="IconSliders">M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6</Geometry>
        <Geometry x:Key="IconRocket">M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 00-2.91-.09z M12 15l-3-3a22 22 0 012-3.95A12.88 12.88 0 0122 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 01-4 2z</Geometry>
        <Geometry x:Key="IconPlus">M12 5v14 M5 12h14</Geometry>
        <Geometry x:Key="IconFolder">M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z</Geometry>
        <Geometry x:Key="IconTrash">M3 6h18 M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2 M10 11v6 M14 11v6</Geometry>
        <Geometry x:Key="IconChart">M18 20V10 M12 20V4 M6 20v-6</Geometry>
        <Geometry x:Key="IconList">M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8</Geometry>
        <Geometry x:Key="IconImage">M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2z M8.5 10a1.5 1.5 0 100-3 1.5 1.5 0 000 3z M21 15l-5-5L5 21</Geometry>
        <Geometry x:Key="IconSearch">M11 19a8 8 0 100-16 8 8 0 000 16z M21 21l-4.35-4.35</Geometry>
        <Geometry x:Key="IconClose">M18 6L6 18 M6 6l12 12</Geometry>
        <Geometry x:Key="IconGrid">M3 3h18v18H3z M3 9h18 M3 15h18 M9 3v18 M15 3v18</Geometry>
        <Geometry x:Key="IconLayers">M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5</Geometry>
        <Geometry x:Key="IconNodes">M18 7a3 3 0 100-6 3 3 0 000 6z M6 21a3 3 0 100-6 3 3 0 000 6z M18 21a3 3 0 100-6 3 3 0 000 6z M8.5 19.5h6.5 M15.5 7.5l-7 10</Geometry>
        <Geometry x:Key="IconTarget">M12 22a10 10 0 100-20 10 10 0 000 20z M12 18a6 6 0 100-12 6 6 0 000 12z M12 14a2 2 0 100-4 2 2 0 000 4z</Geometry>

        <!-- Modern Card Style (from MAI project reference) -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TabItem Style (from MAI project reference) -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="#E2E8F0"
                                Margin="0,0,6,0"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0"
                                BorderBrush="#CBD5E1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#047857" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Outline Button Style -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- APPLICATION HEADER (Refined Modern Card Header from MAI reference) -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderThickness="1" Background="#FFFFFF" BorderBrush="#E2E8F0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.04" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Інформаційно-Екстремальна Інтелектуальна Технологія (ІЕІТ)"
                                   FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <Border Background="#DBEAFE" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ІЕІТ • ЛР №12–15" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Комплексна система розпізнавання образів на базі інформаційно-екстремальної технології (ІЕІТ)"
                               FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text=".NET 10 • WPF • trecognition_obj" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODERN NAVIGATION TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,0">
            <!-- TAB 1: ЛР 12 (ACTIVE) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconGrid}"
                              Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="ЛР №12: Навчальна матриця (Y)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450" MinWidth="420" MaxWidth="560" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: CONTROLS & METRICS -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">

                            <!-- CARD 1: INPUT PARAMETERS & CLASS LOADING -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <!-- Header with vector sliders icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconSliders}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Параметри вхідного опису" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Class count M -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Кількість класів (m):" FontWeight="Medium" Foreground="#334155" />
                                            <TextBlock Text="Мінімум 2 класи" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding TargetM, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" FontWeight="Bold" TextAlignment="Center" Padding="4" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Live Status Badge -->
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding StatusCounterText}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" FontSize="13" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Dimension Mode (Auto vs Manual) -->
                                    <TextBlock Text="Режим визначення розмірності (l, N):" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,6" />
                                    <RadioButton Content="Автоматично за розміром зображення"
                                                 IsChecked="{Binding IsAutoDimensions}"
                                                 GroupName="DimMode" Margin="0,0,0,6" />
                                    <RadioButton Content="Користувацькі розміри (зріз матриці):"
                                                 IsChecked="{Binding IsManualDimensions}"
                                                 GroupName="DimMode" Margin="0,0,0,6" />

                                    <!-- Manual inputs -->
                                    <Grid IsEnabled="{Binding IsManualDimensions}" Margin="20,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Реалізацій (l):" FontSize="11" Foreground="#475569" />
                                            <TextBox Text="{Binding CustomL, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Ознак (N):" FontSize="11" Foreground="#475569" />
                                            <TextBox Text="{Binding CustomN, UpdateSourceTrigger=PropertyChanged}" Padding="4" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Margin="0,4,0,12" Background="#E2E8F0" />

                                    <!-- Action Buttons with Crisp Vector Icons -->
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddImagesCommand}"
                                            Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <TextBlock Text="Додати зображення класу..." VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding LoadDemoResourcesCommand}"
                                            ToolTip="Завантажує 1.bmp та 2.bmp відповідно до варіанта"
                                            Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconFolder}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="Завантажити з папки Resources (Демо)" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource DangerOutlineButtonStyle}"
                                            Command="{Binding ClearAllClassesCommand}"
                                            Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconTrash}" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="Очистити список класів" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- FORM MATRIX BUTTON WITH VECTOR ROCKET -->
                                    <Button Style="{StaticResource SuccessButtonStyle}"
                                            Command="{Binding FormTrainingMatrixCommand}"
                                            FontSize="13">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconRocket}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="СФОРМУВАТИ НАВЧАЛЬНУ МАТРИЦЮ Y" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: QUANTITATIVE CHARACTERISTICS (Expanded & No Text Overlap) -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <!-- Header with vector chart icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconChart}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Кількісні характеристики набору даних" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Grid rows with explicit 2-column layout to prevent any overlapping -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Число класів розпізнавання (m):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding TargetM}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ознак розпізнавання (N, ширина):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding EffectiveN}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Реалізацій образу (l, висота):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding EffectiveL}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Еталонний розмір зображень:" Foreground="#475569" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReferenceDimensionsText}" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>

                                    <!-- TOTAL ELEMENTS ROW WITH PILL BADGE -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Загальний обсяг вибірки:" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TotalElementsCountText}" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <Separator Margin="0,8,0,8" Background="#E2E8F0" />

                                    <TextBlock Text="Стан формування матриці Y:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding MatrixFormedStatusText}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding MatrixStatusBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: LOG & EVENT JOURNAL -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource IconList}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Журнал подій та валідації" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="130">
                                        <ListBox ItemsSource="{Binding LogMessages}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="11"
                                                 FontFamily="Consolas"
                                                 Foreground="#334155" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- GRID SPLITTER -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#CBD5E1" ShowsPreview="True" />

                    <!-- RIGHT COLUMN: GALLERY (TOP) & MATRIX INSPECTOR (BOTTOM) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260" MinHeight="180" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" MinHeight="220" />
                        </Grid.RowDefinitions>

                        <!-- GALLERY OF LOADED CLASSES -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconImage}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Галерея класів розпізнавання" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusCounterText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- LOADED CARDS SCROLLVIEWER -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding LoadedClasses}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                                            Width="210" Margin="6" Padding="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="110" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Card Header with Close Icon -->
                                                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                                                <Border Background="#2563EB" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding ClassIndex, StringFormat='Клас #{0}'}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                                </Border>
                                                                <Button Command="{Binding DataContext.RemoveClassCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Видалити цей клас"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="Right"
                                                                        Cursor="Hand"
                                                                        Padding="4">
                                                                    <Path Data="{StaticResource IconClose}"
                                                                          Width="11" Height="11"
                                                                          Stretch="Uniform"
                                                                          Stroke="#DC2626"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                                </Button>
                                                            </Grid>

                                                            <!-- Thumbnail Preview -->
                                                            <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" Margin="0,0,0,6">
                                                                <Image Source="{Binding PreviewImage}"
                                                                       Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                            </Border>

                                                            <!-- Editable Class Name -->
                                                            <StackPanel Grid.Row="2" Margin="0,0,0,4">
                                                                <TextBlock Text="Назва класу:" FontSize="10" Foreground="#64748B" />
                                                                <TextBox Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="12" FontWeight="SemiBold" Padding="3" />
                                                            </StackPanel>

                                                            <!-- File info -->
                                                            <StackPanel Grid.Row="3">
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Foreground="#334155" />
                                                                <TextBlock Text="{Binding DimensionsString}" FontSize="10" Foreground="#64748B" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- HORIZONTAL SPLITTER -->
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#CBD5E1" ShowsPreview="True" />

                        <!-- MATRIX INSPECTOR (BOTTOM) -->
                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- INSPECTOR HEADER & CONTROLS -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Інспектор матриці Y" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Text="Клас:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569" FontWeight="Medium" />
                                        <ComboBox ItemsSource="{Binding LoadedClasses}"
                                                  DisplayMemberPath="ClassName"
                                                  SelectedIndex="{Binding SelectedClassIndexForInspector}"
                                                  Width="220" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Brightness Stats -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,4" Margin="4,0">
                                            <TextBlock Text="{Binding SelectedMinBrightness, StringFormat='Min: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,4" Margin="4,0">
                                            <TextBlock Text="{Binding SelectedMaxBrightness, StringFormat='Max: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                        </Border>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,4" Margin="4,0">
                                            <TextBlock Text="{Binding SelectedAvgBrightness, StringFormat='Середнє: {0:F1}'}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding SelectedClassMatrixInfo}" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />

                                <!-- MATRIX DATA GRID -->
                                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                                    <controls:FastDataGrid ItemsSource="{Binding CurrentMatrixView}"
                                                          AutoGenerateColumns="True"
                                                          IsReadOnly="True"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          EnableRowVirtualization="True"
                                                          EnableColumnVirtualization="True"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                                          VirtualizingPanel.ScrollUnit="Pixel"
                                                          VirtualizingPanel.CacheLength="1,1"
                                                          VirtualizingPanel.CacheLengthUnit="Page"
                                                          ScrollViewer.CanContentScroll="True"
                                                          HeadersVisibility="All"
                                                          GridLinesVisibility="All"
                                                          HorizontalGridLinesBrush="#E2E8F0"
                                                          VerticalGridLinesBrush="#E2E8F0"
                                                          AlternatingRowBackground="#F8FAFC"
                                                          FontFamily="Consolas"
                                                          FontSize="11"
                                                          RowHeaderWidth="20" />
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: ЛР 13 (АКТИВНА: СКД ТА БІНАРИЗАЦІЯ) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLayers}"
                              Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="ЛР №13: Бінаризація та СКД (X, EV)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450" MinWidth="420" MaxWidth="560" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: CONTROLS & TOLERANCE METRICS -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">

                            <!-- WARNING BANNER IF Y IS NOT FORMED -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding IsYMissing, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Навчальна матриця Y ще не сформована" FontWeight="Bold" Foreground="#92400E" FontSize="13" />
                                    <TextBlock Text="Перейдіть на вкладку «ЛР №12: Навчальна матриця (Y)», завантажте зображення та натисніть «Сформувати навчальну матрицю Y»."
                                               TextWrapping="Wrap" Foreground="#B45309" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 1: BINARIZATION & SKD PARAMETERS -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <!-- Header with vector sliders icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconSliders}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Параметри побудови СКД та бінаризації" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Base Class Selection -->
                                    <TextBlock Text="Базовий клас розпізнавання (base):" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding LoadedClasses}"
                                              DisplayMemberPath="ClassName"
                                              SelectedIndex="{Binding BaseClassIndex}"
                                              Padding="6" Margin="0,0,0,4" />
                                    <TextBlock Text="Визначає центр розподілу та коридор допусків (за замовчуванням Клас 1 - «норма»)"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- Step Delta (StepKD) -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Крок коридору допусків (δ):" FontWeight="Medium" Foreground="#334155" />
                                            <TextBlock Text="Діапазон від 0 до 255" FontSize="11" Foreground="#64748B" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding StepKD, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" FontWeight="Bold" TextAlignment="Center" Padding="4" VerticalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Slider for Delta -->
                                    <Slider Minimum="0" Maximum="255" SmallChange="1" LargeChange="10"
                                            Value="{Binding StepKD, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,0,14" />

                                    <Separator Margin="0,0,0,12" Background="#E2E8F0" />

                                    <!-- Action Button: Form SKD & Binarize -->
                                    <Button Style="{StaticResource SuccessButtonStyle}"
                                            Command="{Binding BinarizeCommand}"
                                            FontSize="13">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconLayers}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="ПОБУДУВАТИ СКД ТА БІНАРИЗУВАТИ" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: QUANTITATIVE CHARACTERISTICS -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <!-- Header with vector chart icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconChart}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Кількісні характеристики СКД та бінаризації" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Базовий клас розпізнавання:" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding BaseClassNameText}" FontWeight="Bold" Foreground="#1E40AF" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Крок коридору допусків (δ):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding StepKD}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Число класів розпізнавання (m):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding MatrixM}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Розмірність матриць (l × N):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock FontWeight="Bold" Foreground="#0F172A">
                                                <Run Text="{Binding MatrixL, Mode=OneWay}" />
                                                <Run Text=" × " />
                                                <Run Text="{Binding MatrixN, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <Separator Margin="0,8,0,8" Background="#E2E8F0" />

                                    <!-- Ones Distribution in X -->
                                    <TextBlock Text="Розподіл одиниць у бінарних матрицях X:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6" />
                                    
                                    <ItemsControl ItemsSource="{Binding BinaryClassesStatistics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                            <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsBaseClass, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="Базовий" FontSize="9" FontWeight="Bold" Foreground="#15803D" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                                            <TextBlock FontWeight="Bold" Foreground="#2563EB" FontSize="11">
                                                                <Run Text="{Binding OnesCount, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                                                <Run Text=" од. (" />
                                                                <Run Text="{Binding Percentage, Mode=OneWay, StringFormat='{}{0:F1}%'}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,6,0,8" Background="#E2E8F0" />

                                    <TextBlock Text="Стан побудови СКД та бінаризації:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding BinarizationStatusText}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding BinarizationStatusBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: LOG & EVENT JOURNAL -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Data="{StaticResource IconList}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Журнал подій та валідації" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="130">
                                        <ListBox ItemsSource="{Binding LogMessages}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="11"
                                                 FontFamily="Consolas"
                                                 Foreground="#334155" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- GRID SPLITTER -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#CBD5E1" ShowsPreview="True" />

                    <!-- RIGHT COLUMN: THREE BLOCKS (TOLERANCE GRAPH, BINARY INSPECTOR, REFERENCE VECTORS) -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,8">

                            <!-- BLOCK A: TOLERANCE CORRIDOR GRAPH -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Graph Header & Legend -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChart}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="Коридор системи контрольних допусків (СКД)" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Legend -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" Margin="3,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#059669" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Верхній (VD = M+δ)" FontSize="10" FontWeight="SemiBold" Foreground="#065F46" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" Margin="3,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Еталон (M[y])" FontSize="10" FontWeight="SemiBold" Foreground="#1E40AF" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" Margin="3,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#D97706" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Нижній (ND = M-δ)" FontSize="10" FontWeight="SemiBold" Foreground="#92400E" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Canvas Graph in Viewbox -->
                                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="205">
                                        <Grid>
                                            <!-- Waiting placeholder when not binarized -->
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding IsBinarizePending, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Графік СКД очікує побудови" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                <TextBlock Text="Натисніть кнопку «ПОБУДУВАТИ СКД ТА БІНАРИЗУВАТИ» для розрахунку та візуалізації коридору"
                                                           FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>

                                            <!-- Rendered Canvas when binarized -->
                                            <Viewbox Stretch="Fill" Height="195"
                                                     Visibility="{Binding IsBinarized, Converter={StaticResource BoolToVisConverter}}">
                                                <Canvas Width="700" Height="200" Background="Transparent">
                                                    <!-- Background gridlines -->
                                                    <Line X1="45" Y1="15" X2="665" Y2="15" Stroke="#E2E8F0" StrokeThickness="1" StrokeDashArray="3,3" />
                                                    <TextBlock Text="255" Canvas.Left="15" Canvas.Top="8" FontSize="10" Foreground="#94A3B8" />

                                                    <Line X1="45" Y1="57.5" X2="665" Y2="57.5" Stroke="#F1F5F9" StrokeThickness="1" StrokeDashArray="2,2" />
                                                    <TextBlock Text="192" Canvas.Left="15" Canvas.Top="51" FontSize="10" Foreground="#94A3B8" />

                                                    <Line X1="45" Y1="100" X2="665" Y2="100" Stroke="#E2E8F0" StrokeThickness="1" StrokeDashArray="3,3" />
                                                    <TextBlock Text="128" Canvas.Left="15" Canvas.Top="93" FontSize="10" Foreground="#94A3B8" />

                                                    <Line X1="45" Y1="142.5" X2="665" Y2="142.5" Stroke="#F1F5F9" StrokeThickness="1" StrokeDashArray="2,2" />
                                                    <TextBlock Text="64" Canvas.Left="20" Canvas.Top="136" FontSize="10" Foreground="#94A3B8" />

                                                    <Line X1="45" Y1="185" X2="665" Y2="185" Stroke="#94A3B8" StrokeThickness="1.5" />
                                                    <TextBlock Text="0" Canvas.Left="26" Canvas.Top="179" FontSize="10" Foreground="#94A3B8" />

                                                    <Line X1="45" Y1="15" X2="45" Y2="185" Stroke="#94A3B8" StrokeThickness="1.5" />

                                                    <!-- Polylines for VD, Mean, ND -->
                                                    <Polyline Points="{Binding ToleranceVDPoints}" Stroke="#059669" StrokeThickness="2" StrokeLineJoin="Round" />
                                                    <Polyline Points="{Binding ToleranceMeanPoints}" Stroke="#2563EB" StrokeThickness="2.2" StrokeLineJoin="Round" />
                                                    <Polyline Points="{Binding ToleranceNDPoints}" Stroke="#D97706" StrokeThickness="2" StrokeLineJoin="Round" />

                                                    <!-- X Axis labels -->
                                                    <TextBlock Text="Ознаки розпізнавання (i = 1..N)" Canvas.Left="270" Canvas.Top="187" FontSize="10" Foreground="#64748B" FontWeight="SemiBold" />
                                                    <TextBlock Text="1" Canvas.Left="45" Canvas.Top="187" FontSize="10" Foreground="#64748B" />
                                                    <TextBlock Text="{Binding MatrixN, StringFormat='N={0}'}" Canvas.Left="640" Canvas.Top="187" FontSize="10" Foreground="#64748B" />
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- BLOCK B: BINARY MATRIX X INSPECTOR & VISUAL MAP -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="260" />
                                    </Grid.RowDefinitions>

                                    <!-- Controls Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="Інспектор бінарної матриці X" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <TextBlock Text="Клас:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569" FontWeight="Medium" />
                                            <ComboBox ItemsSource="{Binding LoadedClasses}"
                                                      DisplayMemberPath="ClassName"
                                                      SelectedIndex="{Binding SelectedClassIndexForBinaryInspector}"
                                                      Width="200" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Quick Stats Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4">
                                                <TextBlock FontWeight="SemiBold" Foreground="#0F172A" FontSize="11">
                                                    <Run Text="Одиниць у матриці: " Foreground="#64748B" />
                                                    <Run Text="{Binding SelectedBinaryOnesCount, Mode=OneWay, StringFormat='{}{0:N0}'}" Foreground="#2563EB" />
                                                    <Run Text=" (" Foreground="#64748B" />
                                                    <Run Text="{Binding SelectedBinaryOnesPercentage, Mode=OneWay, StringFormat='{}{0:F1}%'}" Foreground="#2563EB" />
                                                    <Run Text=")" Foreground="#64748B" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding SelectedBinaryClassInfo}" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />

                                    <!-- Grid & Visual Map side-by-side -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Binary DataGrid -->
                                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                                            <controls:FastDataGrid ItemsSource="{Binding CurrentBinaryMatrixView}"
                                                                  AutoGenerateColumns="True"
                                                                  IsReadOnly="True"
                                                                  CanUserAddRows="False"
                                                                  CanUserDeleteRows="False"
                                                                  EnableRowVirtualization="True"
                                                                  EnableColumnVirtualization="True"
                                                                  VirtualizingPanel.IsVirtualizing="True"
                                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                                  VirtualizingPanel.CacheLength="1,1"
                                                                  VirtualizingPanel.CacheLengthUnit="Page"
                                                                  ScrollViewer.CanContentScroll="True"
                                                                  HeadersVisibility="All"
                                                                  GridLinesVisibility="All"
                                                                  HorizontalGridLinesBrush="#E2E8F0"
                                                                  VerticalGridLinesBrush="#E2E8F0"
                                                                  AlternatingRowBackground="#F8FAFC"
                                                                  FontFamily="Consolas"
                                                                  FontSize="11"
                                                                  RowHeaderWidth="20" />
                                        </Border>

                                        <!-- Visual Map of Matrix X -->
                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="Візуальна карта X (1=чорне, 0=біле)" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" TextAlignment="Center" />

                                                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                                                    <Image Source="{Binding CurrentBinaryVisualMap}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                </Border>

                                                <TextBlock Grid.Row="2" Text="{Binding LoadedClasses[0].DimensionsString}" FontSize="10" Foreground="#94A3B8" TextAlignment="Center" Margin="0,4,0,0" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- BLOCK C: BINARY REFERENCE VECTORS (EV) -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,0">
                                <StackPanel>
                                    <!-- Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="{StaticResource IconTarget}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Двійкові еталонні вектори EV (Штрих-коди центрів класів)" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Waiting placeholder when not binarized -->
                                    <TextBlock Text="Еталонні вектори очікують побудови..." FontSize="11" Foreground="#94A3B8" Margin="0,4,0,4"
                                               Visibility="{Binding IsBinarizePending, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Barcode Cards List -->
                                    <ItemsControl ItemsSource="{Binding ReferenceVectors}"
                                                  Visibility="{Binding IsBinarized, Converter={StaticResource BoolToVisConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 0: Class name and count -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ClassName}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                                        Visibility="{Binding IsBaseClass, Converter={StaticResource BoolToVisConverter}}">
                                                                    <TextBlock Text="Базовий клас" FontSize="9" FontWeight="Bold" Foreground="#15803D" />
                                                                </Border>
                                                            </StackPanel>

                                                            <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                                                <TextBlock FontWeight="SemiBold" Foreground="#2563EB" FontSize="11">
                                                                    <Run Text="Одиниць: " Foreground="#64748B" />
                                                                    <Run Text="{Binding OnesCount, Mode=OneWay}" />
                                                                    <Run Text=" з " Foreground="#64748B" />
                                                                    <Run Text="{Binding TotalFeatures, Mode=OneWay}" />
                                                                    <Run Text=" (" Foreground="#64748B" />
                                                                    <Run Text="{Binding Percentage, Mode=OneWay, StringFormat='{}{0:F1}%'}" />
                                                                    <Run Text=")" />
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 1: Barcode Strip -->
                                                        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2" Height="28">
                                                            <Image Source="{Binding BarcodeImage}"
                                                                   Stretch="Fill"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </TabItem>

            <!-- TAB 3: ЛР 14 (ACTIVE) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconNodes}"
                              Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="ЛР №14: Кодові відстані (SK)" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: CONTROLS, PARAMS & STATS -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- Prerequisite Alert when Y or Binarization not done -->
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    Visibility="{Binding IsBinarizePending, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Потрібна попередня бінаризація" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,4" />
                                    <TextBlock Text="Перейдіть на вкладку «ЛР №13: Бінаризація та СКД» та виконайте побудову СКД і бінаризацію."
                                               FontSize="12" Foreground="#B45309" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 1: PARAMETERS OF CODE DISTANCES & PARA -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconSliders}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Параметри кодових відстаней" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Current Class Selection -->
                                    <TextBlock Text="Поточний клас розпізнавання (m):" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding LoadedClasses}"
                                              DisplayMemberPath="ClassName"
                                              SelectedIndex="{Binding SelectedDistanceClassIndex}"
                                              Padding="6" Margin="0,0,0,4" />
                                    <TextBlock Text="Визначає клас для перегляду відстаней SK та карти SK_MAP відносно його сусіда PARA[m]"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <!-- Found Neighbor Info Card -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Найближчий сусід-конкурент (PARA):" FontSize="11" Foreground="#64748B" />
                                            <TextBlock Text="{Binding NearestNeighborName}" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,2,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Відстань між центрами D = " FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CenterDistanceD, StringFormat='{}{0} біт'}" FontWeight="Bold" Foreground="#1E40AF" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Compute Distances Action Button -->
                                    <Button Style="{StaticResource SuccessButtonStyle}"
                                            Command="{Binding ComputeDistancesCommand}"
                                            FontSize="13">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource IconNodes}" Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <TextBlock Text="РОЗРАХУВАТИ SK ТА SK_MAP" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: QUANTITATIVE CHARACTERISTICS -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconChart}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Кількісні характеристики (SK, PARA)" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Відстань між еталонами (D):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding CenterDistanceD}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Кількість реалізацій (l):" Foreground="#475569" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding MatrixL}" FontWeight="Bold" Foreground="#0F172A" />
                                        </Border>
                                    </Grid>

                                    <Separator Margin="0,8,0,8" Background="#E2E8F0" />

                                    <TextBlock Text="Статистика відстаней (Min / Max / Середнє):" FontWeight="SemiBold" FontSize="11" Foreground="#334155" Margin="0,0,0,6" />

                                    <!-- SK[1]: Свій -> C1 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SK[1] (свій → C1):" FontWeight="SemiBold" Foreground="#1E40AF" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center">
                                                <Run Text="{Binding DistanceStats.SkOwnMin, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkOwnMax, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkOwnAvg, Mode=OneWay, StringFormat='{}{0:F2}'}" Foreground="#2563EB" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- SK[2]: Сусід -> C1 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SK[2] (сусід → C1):" FontWeight="SemiBold" Foreground="#B45309" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center">
                                                <Run Text="{Binding DistanceStats.SkNeighborMin, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkNeighborMax, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkNeighborAvg, Mode=OneWay, StringFormat='{}{0:F2}'}" Foreground="#D97706" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- SK_PARA[1]: Сусід -> C2 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SK_PARA[1] (сусід → C2):" FontWeight="SemiBold" Foreground="#C2410C" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center">
                                                <Run Text="{Binding DistanceStats.SkParaNeighborMin, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkParaNeighborMax, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkParaNeighborAvg, Mode=OneWay, StringFormat='{}{0:F2}'}" Foreground="#EA580C" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <!-- SK_PARA[2]: Свій -> C2 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SK_PARA[2] (свій → C2):" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center">
                                                <Run Text="{Binding DistanceStats.SkParaOwnMin, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkParaOwnMax, Mode=OneWay}" />
                                                <Run Text=" / " Foreground="#94A3B8" />
                                                <Run Text="{Binding DistanceStats.SkParaOwnAvg, Mode=OneWay, StringFormat='{}{0:F2}'}" Foreground="#334155" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <Separator Margin="0,4,0,8" Background="#E2E8F0" />
                                    <TextBlock Text="Стан розрахунку кодових відстаней:" FontSize="11" Foreground="#64748B" />
                                    <TextBlock Text="{Binding DistancesStatusText}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding DistancesStatusBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: LOG & EVENT JOURNAL -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="{StaticResource IconList}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                              Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Журнал подій та валідації" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="130">
                                        <ListBox ItemsSource="{Binding LogMessages}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="11"
                                                 FontFamily="Consolas"
                                                 Foreground="#334155" />
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT PANEL: SK_MAP MODULE & DISTANCES INSPECTOR -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- BLOCK A: SK_MAP 2D VISUALIZATION CANVAS -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header and Legends -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconNodes}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="Модуль SK_MAP: Карта розподілу реалізацій на 2D-площині"
                                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Legend -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="#2563EB" Margin="0,0,4,0" />
                                            <TextBlock Text="Поточний клас" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,12,0" />

                                            <Ellipse Width="9" Height="9" Fill="#EA580C" Margin="0,0,4,0" />
                                            <TextBlock Text="Сусід PARA" FontSize="11" FontWeight="SemiBold" Foreground="#9A3412" Margin="0,0,12,0" />

                                            <Border Background="#1E293B" CornerRadius="3" Width="9" Height="9" Margin="0,0,4,0" />
                                            <TextBlock Text="Центри C1, C2" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Subtitle & Scale / Bounds details -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding SkMapWorldBoundsText}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Canvas Drawing Area -->
                                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Height="285">
                                        <Grid>
                                            <!-- State 1: Pending calculation -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsDistancesPending, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="📊 Карта SK_MAP очікує запуску розрахунку" FontWeight="SemiBold" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" />
                                                <TextBlock Text="Оберіть клас та натисніть «РОЗРАХУВАТИ SK ТА SK_MAP» у панелі ліворуч."
                                                           FontSize="11" Foreground="#CBD5E1" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- State 2: Warning when D == 0 (Coinciding centers) -->
                                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="16" Margin="16"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600"
                                                    Visibility="{Binding IsCentersCoincide, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="⚠️ Центри еталонів повністю збіглися (D = 0)" FontWeight="Bold" Foreground="#92400E" FontSize="13" Margin="0,0,0,6" />
                                                    <TextBlock Text="Відстань між двійковими еталонними векторами поточного класу та його сусіда становить D = 0 біт (образи стали нерозрізними за Хеммінгом). Побудова 2D-карти триангуляції неможлива через ділення на нуль."
                                                               Foreground="#B45309" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBlock Text="Таблицю значень SK та статистику сформовано повністю (див. інспектор нижче). Для відновлення графічної карти зменшіть крок допуску δ на вкладці ЛР №13."
                                                               Foreground="#B45309" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- State 3: Active Canvas when D > 0 -->
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding IsDistancesComputed, Converter={StaticResource BoolToVisConverter}}">
                                                <Canvas Width="720" Height="280" Background="Transparent" ClipToBounds="True">
                                                    <!-- Axis line connecting centers through Y = AxisLineY -->
                                                    <Line X1="{Binding AxisLineX1}" Y1="{Binding AxisLineY}"
                                                          X2="{Binding AxisLineX2}" Y2="{Binding AxisLineY}"
                                                          Stroke="#94A3B8" StrokeThickness="1.5" StrokeDashArray="4,4" />

                                                    <TextBlock Text="Горизонтальна вісь центрів (y = 0)"
                                                               Canvas.Left="{Binding AxisLabelCanvasX}" Canvas.Top="{Binding AxisLineY}"
                                                               Margin="0,4,0,0" FontSize="10" Foreground="#64748B" FontWeight="Medium" />

                                                    <!-- Center C1(0, 0) Marker -->
                                                    <Ellipse Width="16" Height="16"
                                                             Canvas.Left="{Binding C1CanvasX}" Canvas.Top="{Binding C1CanvasY}"
                                                             Margin="-8,-8,0,0"
                                                             Fill="#2563EB" Stroke="White" StrokeThickness="2.5" />
                                                    <TextBlock Text="C1 (0, 0)"
                                                               Canvas.Left="{Binding C1CanvasX}" Canvas.Top="{Binding C1CanvasY}"
                                                               Margin="-24,-24,0,0"
                                                               FontSize="11" FontWeight="Bold" Foreground="#1E40AF" />

                                                    <!-- Center C2(D, 0) Marker -->
                                                    <Ellipse Width="16" Height="16"
                                                             Canvas.Left="{Binding C2CanvasX}" Canvas.Top="{Binding C2CanvasY}"
                                                             Margin="-8,-8,0,0"
                                                             Fill="#EA580C" Stroke="White" StrokeThickness="2.5" />
                                                    <TextBlock Text="{Binding CenterDistanceD, StringFormat='C2 ({0}, 0)'}"
                                                               Canvas.Left="{Binding C2CanvasX}" Canvas.Top="{Binding C2CanvasY}"
                                                               Margin="-26,-24,0,0"
                                                               FontSize="11" FontWeight="Bold" Foreground="#9A3412" />

                                                    <!-- Realization Points -->
                                                    <ItemsControl ItemsSource="{Binding SkMapPoints}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                                                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Ellipse Width="7" Height="7" Margin="-3.5,-3.5,0,0"
                                                                         Fill="{Binding PointColor}" Stroke="{Binding PointStroke}"
                                                                         StrokeThickness="1"
                                                                         ToolTip="{Binding TooltipText}" Cursor="Hand" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- BLOCK B: DISTANCES INSPECTOR (FastDataGrid) -->
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="240" />
                                    </Grid.RowDefinitions>

                                    <!-- Controls Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Margin="0,0,8,0" Stretch="Uniform"
                                                  Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="Інспектор кодових відстаней SK та SK_PARA" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding DistancesStatusText}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="11" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding DistancesInspectorInfo}" FontSize="11" Foreground="#64748B" Margin="0,0,0,6" />

                                    <!-- FastDataGrid for Distances -->
                                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White">
                                        <controls:FastDataGrid ItemsSource="{Binding DistancesDataView}"
                                                              AutoGenerateColumns="False"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"
                                                              CanUserDeleteRows="False"
                                                              EnableRowVirtualization="True"
                                                              EnableColumnVirtualization="True"
                                                              VirtualizingPanel.IsVirtualizing="True"
                                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                                              GridLinesVisibility="All"
                                                              HorizontalGridLinesBrush="#F1F5F9"
                                                              VerticalGridLinesBrush="#F1F5F9"
                                                              RowHeight="25"
                                                              ColumnHeaderHeight="30"
                                                              FontSize="12"
                                                              BorderThickness="0">
                                            <controls:FastDataGrid.Columns>
                                                <DataGridTextColumn Header="Реалізація" Binding="{Binding Realization}" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="Foreground" Value="#334155" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="SK[1] (свій → C1)" Binding="{Binding SK_1}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="Foreground" Value="#1E40AF" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="SK[2] (сусід → C1)" Binding="{Binding SK_2}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="Foreground" Value="#334155" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="SK_PARA[1] (сусід → C2)" Binding="{Binding SK_PARA_1}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="Foreground" Value="#9A3412" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>

                                                <DataGridTextColumn Header="SK_PARA[2] (свій → C2)" Binding="{Binding SK_PARA_2}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                            <Setter Property="Foreground" Value="#334155" />
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </controls:FastDataGrid.Columns>
                                        </controls:FastDataGrid>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 4: ЛР 15 (PREVIEW) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTarget}"
                              Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="ЛР №15: Оптимізація КФЕ та Екзамен" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,14,0,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Лабораторна робота №15: Розрахунок інформаційного критерію, пошук радіусів та екзамен"
                                           FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10" />
                                <TextBlock Text="Етапи виконання у ЛР №15:" FontSize="13" Foreground="#475569" Margin="0,0,0,10" />

                                <TextBlock Margin="10,3" Foreground="#334155">
                                    • <Bold>Розрахунок точнісних характеристик:</Bold> обчислення достовірностей D1, D2 та помилок 1-го і 2-го роду A (альфа) та B (бета) для радіусів контейнера d = 0..N.
                                </TextBlock>
                                <TextBlock Margin="10,3" Foreground="#334155">
                                    • <Bold>Оптимізація КФЕ (критерій Кульбака) EM[M][N+1]:</Bold> знаходження глобального максимуму критерію функціональної ефективності та фіксація оптимальних радіусів контейнерів класів D[M].
                                </TextBlock>
                                <TextBlock Margin="10,3" Foreground="#334155">
                                    • <Bold>Реалізація алгоритму екзамену (Exam):</Bold> класифікація контрольних або зашумлених реалізацій за геометричним вирішальним правилом.
                                </TextBlock>

                                <Separator Margin="0,14,0,14" Background="#E2E8F0" />
                                <TextBlock Text="Поточний стан структури даних trecognition_obj:" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding MatrixFormedStatusText}" Foreground="{Binding MatrixStatusBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,6,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#0F172A" Opacity="0.03" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Готово до роботи. Оберіть дію в панелі керування." FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="ІЕІТ • СПР" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
